{
  "name": "eldervalley",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "contracts:compile": "hardhat compile",
    "contracts:test": "hardhat test",
    "contracts:slither": "node scripts/run-slither.cjs --exclude-informational",
    "contracts:slither:raw": "node scripts/run-slither.cjs",
    "contracts:preflight:base": "node scripts/preflight-base-deploy.cjs",
    "contracts:deploy:base": "hardhat run scripts/deploy-houses.cjs --network base",
    "contracts:deploy:base:full": "npm run contracts:compile && npm run contracts:test && npm run contracts:slither && npm run contracts:preflight:base && npm run contracts:deploy:base",
    "contracts:verify:base": "hardhat run scripts/verify-houses.cjs --network base",
    "contracts:railway-vars:base": "node scripts/print-railway-contract-vars.cjs"
  },
  "dependencies": {
    "ethers": "^6.16.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-verify": "^2.1.0",
    "@openzeppelin/contracts": "^5.0.2",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0"
  }
}
